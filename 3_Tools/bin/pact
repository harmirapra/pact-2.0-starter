AGENTS_MD = REPO_ROOT / "AGENTS.md"
CONTEXT_DIR = REPO_ROOT / "2_Context"
SCOPE_YML = CONTEXT_DIR / "scope.yml"
PROJECTS_DIR = REPO_ROOT / "0_Projects"
TEMPLATE_PROJECT = PROJECTS_DIR / "_TEMPLATE" / "PROJECT.md"

MANIFEST_NAME = ".pact-manifest.json"

FALLBACK_PROJECT_TEMPLATE = """\
<!-- TEMPLATE:single-root -->
---
